{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ft-bkk-site",
  // La French Tech Bangkok's Cloudflare account (since 7 Nov 2026; before: Eric's personal one).
  // Builds and `wrangler` on a computer logged in to several accounts always target this one.
  "account_id": "e7a57ef939b5164fe76c7f5fc8da9d07",
  // Custom entry: Astro's fetch handler + our scheduled (cron) handler.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // The live site is on workers.dev until the domain moves. Preview URLs give each uploaded version
  // its own address; production builds upload versions that are promoted by hand in Cloudflare
  // (docs/deploy.md, "Validate, then promote").
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: `wrangler deploy` finds the database by name, or creates it on the first
      // deploy (wrangler auto-provisioning). The R2 bucket below must exist already (docs/deploy.md).
      "database_name": "ftbkk",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ftbkk-media",
    },
  ],
  "vars": {
    // Cloudflare Zero Trust team domain(s), comma-separated (the French Tech account's team; add the
    // new name here, comma-separated, before renaming the team).
    "ACCESS_TEAM_DOMAIN": "blue-moon-6a6f.cloudflareaccess.com",
    // Audience tag of the Access application protecting /admin. Emptied locally by .dev.vars.
    "ACCESS_AUD": "0751b83324bb0e3642e7ea896ae4620a40a6c76e4c0166302aaed28f9e651e07",
    // Public Turnstile site key (widget "FT Bangkok site" in the French Tech account); its secret is the
    // Worker secret TURNSTILE_SECRET.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF3DXozO_czZrbCo",
    // Base of the links in emails. The workers.dev address until the domain moves here (phase 10),
    // since www.french-tech-bangkok.com still serves the Wix site.
    "SITE_URL": "https://french-tech-bangkok.com",
    // Sender, on mail.delattre.me (verified in Resend) until french-tech-bangkok.com's DNS moves to
    // us. Then switch to "La French Tech Bangkok <hello@french-tech-bangkok.com>".
    "EMAIL_FROM": "La French Tech Bangkok <noreply@mail.french-tech-bangkok.com>",
    // Emails Resend sends per day (its free plan: 100). Email the community warns when an audience
    // is bigger than what is left today. Ignored while Amazon SES sends (no daily cap).
    "EMAIL_DAILY_LIMIT": "100",
    // Emails Resend sends per month (its free plan: 3000), shown against what was sent in
    // Reports > Emails. Ignored while Amazon SES sends.
    "EMAIL_MONTHLY_LIMIT": "3000",
    // Default sender until one is chosen in Admin > Email delivery (which then wins): "resend"
    // (RESEND_API_KEY) or "ses" (Amazon SES: the secrets AWS_SES_ACCESS_KEY_ID and
    // AWS_SES_SECRET_ACCESS_KEY, docs/deploy.md "Amazon SES").
    "EMAIL_PROVIDER": "resend",
    // Amazon SES region (Sydney: the AWS account only allows its home region) and its maximum send
    // rate per second for bulk sends: 1 while the account is in the SES sandbox, 14 once
    // production access is granted (SES > Account dashboard > Sending limits).
    "AWS_REGION": "ap-southeast-2",
    "SES_SEND_RATE": "12",
    // SNS topic that brings SES bounces and complaints to /api/ses-events (empty = any topic, the
    // secret SES_EVENTS_KEY in the subscription URL still has to match).
    "SES_EVENTS_TOPIC_ARN": "",
    // SES configuration set whose event publishing sends every send, delivery, open and click to
    // that SNS topic too, for Reports > Emails (docs/deploy.md 6b, step 8). Empty = only bounces
    // and complaints come back.
    "SES_CONFIGURATION_SET": "",
    // Social media (Admin > Social media). Empty = not connected: scheduled posts arrive by email
    // to post by hand. The page tokens are the secrets LINKEDIN_ACCESS_TOKEN and
    // FACEBOOK_PAGE_TOKEN (docs/deploy.md, "Connect LinkedIn and Facebook").
    "LINKEDIN_ORGANIZATION_ID": "",
    "FACEBOOK_PAGE_ID": "",
    // Reports > Website traffic reads Cloudflare's Analytics API with the secret CF_ANALYTICS_TOKEN
    // (docs/deploy.md, "Website traffic report"). Both can stay empty: the account is the only one
    // the token reads, the site is the Web Analytics site whose token is in Settings.
    "CF_ACCOUNT_ID": "e7a57ef939b5164fe76c7f5fc8da9d07",
    "CF_WEB_ANALYTICS_SITE_TAG": "",
  },
  "triggers": {
    // Every hour, for scheduled social media posts; the daily jobs run at 02:00 UTC = 09:00
    // Asia/Bangkok (src/lib/cron.ts).
    "crons": ["0 * * * *"],
  },
}
