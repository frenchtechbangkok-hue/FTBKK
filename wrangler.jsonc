{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ft-bkk-site",
  // Custom entry: Astro's fetch handler + our scheduled (cron) handler.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: `wrangler deploy` finds the database by name, or creates it on the first
      // deploy (wrangler auto-provisioning). The R2 bucket below must exist already (docs/deploy.md).
      "database_name": "ftbkk",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ftbkk-media",
    },
  ],
  "vars": {
    // Cloudflare Zero Trust team domain(s), comma-separated: the team was renamed from delattre to
    // ftbkk, keys come from ftbkk while tokens are still issued by delattre.
    "ACCESS_TEAM_DOMAIN": "ftbkk.cloudflareaccess.com,delattre.cloudflareaccess.com",
    // Audience tag of the Access application protecting /admin. Emptied locally by .dev.vars.
    "ACCESS_AUD": "55b16ed23629446d19a82aaf7ee44d0188f91cf1fd2470504b342112a15d321f",
    // Public Turnstile site key. This is Cloudflare's always-pass test key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Base of the links in emails. The workers.dev address until the domain moves here (phase 10),
    // since www.french-tech-bangkok.com still serves the Wix site.
    "SITE_URL": "https://ft-bkk-site.edelattre.workers.dev",
    // Sender, on mail.delattre.me (verified in Resend) until french-tech-bangkok.com's DNS moves to
    // us. Then switch to "La French Tech Bangkok <hello@french-tech-bangkok.com>".
    "EMAIL_FROM": "La French Tech Bangkok <noreply@mail.delattre.me>",
    // Emails the provider sends per day (Resend's free plan: 100). Email the community warns when
    // an audience is bigger than what is left today. Empty or 0 = no warning (Amazon SES).
    "EMAIL_DAILY_LIMIT": "100",
    // Who sends the emails: "resend" (RESEND_API_KEY) or "ses" (Amazon SES: the secrets
    // AWS_SES_ACCESS_KEY_ID and AWS_SES_SECRET_ACCESS_KEY, docs/deploy.md "Amazon SES"). Switching
    // to "ses": also empty EMAIL_DAILY_LIMIT. Back to Resend at any time by setting "resend" again.
    "EMAIL_PROVIDER": "resend",
    // Amazon SES region (Sydney: the AWS account only allows its home region) and its maximum send
    // rate per second for bulk sends: 1 while the account is in the SES sandbox, 14 once
    // production access is granted (SES > Account dashboard > Sending limits).
    "AWS_REGION": "ap-southeast-2",
    "SES_SEND_RATE": "10",
    // SNS topic that brings SES bounces and complaints to /api/ses-events (empty = any topic, the
    // secret SES_EVENTS_KEY in the subscription URL still has to match).
    "SES_EVENTS_TOPIC_ARN": "",
    // Social media (Admin > Social media). Empty = not connected: scheduled posts arrive by email
    // to post by hand. The page tokens are the secrets LINKEDIN_ACCESS_TOKEN and
    // FACEBOOK_PAGE_TOKEN (docs/deploy.md, "Connect LinkedIn and Facebook").
    "LINKEDIN_ORGANIZATION_ID": "",
    "FACEBOOK_PAGE_ID": "",
    // Reports > Website traffic reads Cloudflare's Analytics API with the secret CF_ANALYTICS_TOKEN
    // (docs/deploy.md, "Website traffic report"). Both can stay empty: the account is the only one
    // the token reads, the site is the Web Analytics site whose token is in Settings.
    "CF_ACCOUNT_ID": "",
    "CF_WEB_ANALYTICS_SITE_TAG": "",
  },
  "triggers": {
    // Every hour, for scheduled social media posts; the daily jobs run at 02:00 UTC = 09:00
    // Asia/Bangkok (src/lib/cron.ts).
    "crons": ["0 * * * *"],
  },
}
