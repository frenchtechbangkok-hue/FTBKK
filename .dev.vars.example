# Copy to .dev.vars for local development. Never commit .dev.vars.
# Cloudflare's always-pass Turnstile test keys (the real site key in wrangler.jsonc only works on
# the site's own hostnames):
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Leave empty locally: emails are logged to the console instead of sent.
RESEND_API_KEY=
# Amazon SES, used when EMAIL_PROVIDER is "ses" (docs/deploy.md, "Amazon SES"). Locally, set
# EMAIL_PROVIDER=ses here too to try it; without keys SES sends fail instead of being logged.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Secret part of the bounce notifications URL (/api/ses-events?key=...): any long random string.
SES_EVENTS_KEY=
# Signing secret of Resend's webhook (/api/resend-events), for Reports > Emails: "whsec_...".
RESEND_WEBHOOK_SECRET=
# Local only: overrides the production Access audience in wrangler.jsonc so that
# requireAdmin() accepts DEV_ADMIN_EMAIL instead of a Cloudflare Access login.
ACCESS_AUD=
DEV_ADMIN_EMAIL=admin@example.com
# Set to 1 only if challenges.cloudflare.com is unreachable from your machine.
# DEV_SKIP_TURNSTILE=1
# Links in emails point here during local development.
SITE_URL=http://localhost:4321
# Social media page tokens (Admin > Social media). Leave empty locally: due posts are emailed.
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
# Reports > Website traffic: a Cloudflare API token with Account Analytics: Read. Empty = the
# report explains how to connect it.
CF_ANALYTICS_TOKEN=
