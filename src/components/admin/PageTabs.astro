---
// A row of tabs for the sections of one admin screen (Page texts, Reports...). The menu lists the
// same sections; the tabs keep them one tap away on a phone, where the menu is folded.
interface Props {
  label: string;
  tabs: { href: string; label: string; current: boolean }[];
}
const { label, tabs } = Astro.props;
---

<nav aria-label={label} class="mb-6 flex flex-wrap gap-2">
  {tabs.map((t) => (
    <a
      href={t.href}
      aria-current={t.current ? 'page' : undefined}
      class="rounded-full border border-line bg-paper px-4 py-1.5 text-sm no-underline aria-[current=page]:border-navy aria-[current=page]:bg-navy aria-[current=page]:text-paper"
    >
      {t.label}
    </a>
  ))}
</nav>
