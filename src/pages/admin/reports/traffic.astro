---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import LineChart from '../../../components/admin/LineChart.astro';
import ReportTabs from '../../../components/admin/ReportTabs.astro';
import ReportFilters from '../../../components/admin/ReportFilters.astro';
import Kpi from '../../../components/admin/Kpi.astro';
import BarList from '../../../components/admin/BarList.astro';
import Alert from '../../../components/Alert.astro';
import { delta, num, periodQuery } from '../../../lib/report-period';
import { loadTrafficReport } from '../../../lib/reports';
import {
  formatVital,
  VITAL_LABELS,
  VITAL_THRESHOLDS,
  vitalRating,
  type VitalName,
} from '../../../lib/traffic';

// Reports > Website traffic: visits, pages, sources and speed from Cloudflare Web Analytics, and
// the requests this Worker served. Read from Cloudflare's API at each visit (src/lib/traffic.ts).
const { period, beacon, connected, report: r, error } = await loadTrafficReport(Astro.url);
const n = num;
const day = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Asia/Bangkok',
});
const p = r?.pageloads.data;
const days = (range: { from: Date; to: Date } | null) =>
  range ? Math.max(1, (range.to.getTime() - range.from.getTime()) / 86400000) : 1;
const prev = r?.previous;
const kpis = p
  ? [
      {
        label: 'Visits',
        value: n(p.visits),
        delta: delta(p.visits, prev?.visits ?? null),
        hint: 'A visit starts when someone opens the site from elsewhere (search, link, typed)',
        spark: p.visitsSeries,
      },
      {
        label: 'Page views',
        value: n(p.pageViews),
        delta: delta(p.pageViews, prev?.pageViews ?? null),
        hint: 'Every page opened, including several in one visit',
        spark: p.viewsSeries,
      },
      {
        label: 'Pages per visit',
        value: p.visits ? (p.pageViews / p.visits).toFixed(1) : '–',
        delta: delta(
          p.visits ? p.pageViews / p.visits : null,
          prev?.visits ? prev.pageViews / prev.visits : null,
          'rating',
        ),
        hint: 'How far people read once they arrive',
      },
      {
        label: 'Visits per day',
        value: n(p.visits / days(r!.pageloads.range)),
        delta: delta(
          p.visits / days(r!.pageloads.range),
          prev ? prev.visits / days(period.previous) : null,
        ),
        hint: p.tops.referrers[0]
          ? `Top source: ${p.tops.referrers[0][0]} (${n(p.tops.referrers[0][1])} visits)`
          : undefined,
      },
    ]
  : [];
const vitals = r?.vitals.data;
const names: VitalName[] = ['lcp', 'inp', 'cls'];
const tone = { good: 'text-success', fair: 'text-warning', poor: 'text-danger' };
const ratingText = { good: 'Good', fair: 'Needs improvement', poor: 'Poor' };
const w = r?.worker.data;
const dash = r ? `https://dash.cloudflare.com/${r.accountId}/web-analytics` : null;
const sliced = (range: { from: Date } | null) =>
  range && range.from.getTime() > period.from.getTime() ? range.from : null;
const startsLater = r ? sliced(r.pageloads.range) : null;
---

<AdminLayout title="Reports: website traffic">
  <ReportTabs />
  <ReportFilters
    period={period}
    csv={
      r && !r.pageloads.error
        ? [
            {
              href: `/admin/reports/traffic.csv?${new URLSearchParams(periodQuery(period))}`,
              label: 'Export visits CSV',
            },
            {
              href: `/admin/reports/traffic.csv?${new URLSearchParams({ ...periodQuery(period), table: 'pages' })}`,
              label: 'Export pages CSV',
            },
          ]
        : []
    }
  />
  <p class="mb-6 max-w-3xl text-sm text-muted">
    Who visits the public website, what they read, where they come from and how fast pages load for
    them, from Cloudflare Web Analytics. It counts without cookies and doesn't track people, so the
    figures are estimates (Cloudflare samples busy periods). Admin pages are not counted.
    {dash && (
      <>
        {' '}
        More detail in <a href={dash}>Cloudflare Web Analytics</a>.
      </>
    )}
  </p>

  {!beacon && (
    <Alert tone="warning" class="mb-6">
      <h2 class="text-lg text-warning">Visitor counting is off</h2>
      <p class="mt-1 text-sm text-ink">
        Visits are only counted while{' '}
        <a href="/admin/settings">Settings &gt; General &gt; Cloudflare Web Analytics token</a> is
        filled in. Figures start from the day it is saved.
      </p>
    </Alert>
  )}

  {!connected && (
    <div class="admin-panel mb-6 max-w-3xl">
      <h2 class="text-lg">Connect Cloudflare to see the figures</h2>
      <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm">
        <li>
          In the Cloudflare dashboard, open My Profile &gt; API Tokens &gt; Create Token &gt; Custom
          token. Give it the permission <strong>Account &gt; Account Analytics &gt; Read</strong>{' '}
          for the French Tech account, and create it.
        </li>
        <li>
          Add it to the website: Workers &amp; Pages &gt; ft-bkk-site &gt; Settings &gt; Variables
          and Secrets &gt; Add, type <strong>Secret</strong>, name <code>CF_ANALYTICS_TOKEN</code>,
          paste the token, and deploy.
        </li>
        <li>Reload this page.</li>
      </ol>
      <p class="mt-2 text-xs text-muted">
        Step by step in docs/deploy.md, “Website traffic report”.
      </p>
    </div>
  )}

  {error && (
    <Alert tone="danger" class="mb-6">
      <h2 class="text-lg text-danger">Cloudflare didn't answer</h2>
      <p class="mt-1 text-sm text-ink">{error}</p>
    </Alert>
  )}

  {r && (
    <>
      {r.pageloads.error ? (
        <Alert tone="danger" class="mb-6">
          <h2 class="text-lg text-danger">Visits could not be loaded</h2>
          <p class="mt-1 text-sm text-ink">{r.pageloads.error}</p>
        </Alert>
      ) : (
        <>
          {startsLater && (
            <p class="mb-4 text-sm text-muted">
              Cloudflare keeps about six months of visits: figures start on{' '}
              {day.format(startsLater)}.
            </p>
          )}
          <section aria-label="Key numbers" class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {kpis.map((k) => (
              <Kpi {...k} />
            ))}
          </section>
          <div class="mb-6">
            <LineChart
              title={`Visits and page views, per ${r.unit}`}
              wide
              labels={r.buckets.map((b) => b.label)}
              series={[
                { name: 'Page views', values: p!.viewsSeries, tone: 'navy' },
                { name: 'Visits', values: p!.visitsSeries, tone: 'brand' },
              ]}
              empty="No visits recorded in this period."
            />
          </div>
          <div class="mb-6 grid gap-6 lg:grid-cols-2">
            <BarList
              title="Most viewed pages"
              hint="Page views"
              rows={p!.tops.pages}
              tone="navy"
              empty="No page views in this period."
            />
            <BarList
              title="Where visitors come from"
              hint="Visits, by the site that sent them"
              rows={p!.tops.referrers}
              shares
              empty="No visits in this period."
            />
          </div>
          <div class="mb-6 grid gap-6 lg:grid-cols-3">
            <BarList
              title="Countries"
              hint="Visits"
              rows={p!.tops.countries}
              shares
              tone="brand"
              empty="No visits in this period."
            />
            <BarList
              title="Devices"
              hint="Visits"
              rows={p!.tops.devices}
              shares
              tone="navy"
              empty="No visits in this period."
            />
            <BarList
              title="Browsers"
              hint="Visits"
              rows={p!.tops.browsers}
              shares
              empty="No visits in this period."
            />
          </div>
        </>
      )}

      <section class="mb-6" aria-labelledby="speed-title">
        <h2 id="speed-title" class="mb-1 text-lg">
          Speed for real visitors
        </h2>
        <p class="mb-3 max-w-3xl text-sm text-muted">
          Google's Core Web Vitals, measured in visitors' browsers (the real-user figures of
          Cloudflare Observatory). The value is what 3 visitors out of 4 get or better; Google
          counts a site as fast when it is in the good range.
        </p>
        {r.vitals.error ? (
          <Alert tone="danger">Speed figures could not be loaded: {r.vitals.error}</Alert>
        ) : (
          <div class="grid gap-4 sm:grid-cols-3">
            {names.map((k) => {
              const v = vitals![k];
              const rating = vitalRating(k, v.p75);
              const [good, poor] = VITAL_THRESHOLDS[k];
              return (
                <div class="admin-panel">
                  <p class="text-sm text-muted">{VITAL_LABELS[k]}</p>
                  <p class="mt-1 font-display text-2xl font-bold text-navy md:text-3xl">
                    {formatVital(k, v.p75)}
                  </p>
                  {rating && (
                    <p class={`mt-1 text-sm font-semibold ${tone[rating]}`}>{ratingText[rating]}</p>
                  )}
                  <p class="mt-2 text-xs text-muted">
                    {v.good === null
                      ? 'No measurement in this period.'
                      : `${Math.round(v.good * 100)}% of ${n(v.total)} page views were good. `}
                    Good up to {formatVital(k, good)}, poor above {formatVital(k, poor)}.
                  </p>
                </div>
              );
            })}
          </div>
        )}
      </section>

      <section aria-labelledby="server-title">
        <h2 id="server-title" class="mb-1 text-lg">
          Server
        </h2>
        <p class="mb-3 max-w-3xl text-sm text-muted">
          Every request the website answered: pages, images, forms and the admin, including search
          engines and bots, so it is much higher than page views.
          {sliced(r.worker.range) &&
            ` Cloudflare keeps three months of these: from ${day.format(sliced(r.worker.range)!)}.`}
        </p>
        {r.worker.error ? (
          <Alert tone="danger">Server figures could not be loaded: {r.worker.error}</Alert>
        ) : (
          <div class="grid items-start gap-6 lg:grid-cols-[1fr_2fr]">
            <div class="grid grid-cols-2 gap-4 lg:grid-cols-1">
              <Kpi label="Requests" value={n(w!.requests)} />
              <Kpi
                label="Errors"
                value={n(w!.errors)}
                hint={
                  w!.requests
                    ? `${((w!.errors / w!.requests) * 100).toFixed(2)}% of requests failed with a server error`
                    : undefined
                }
              />
            </div>
            <LineChart
              title={`Requests, per ${r.unit}`}
              labels={r.buckets.map((b) => b.label)}
              series={[{ name: 'Requests', values: w!.series, tone: 'navy' }]}
              empty="No requests recorded in this period."
            />
          </div>
        )}
      </section>
    </>
  )}
</AdminLayout>
