---
import { and, asc, desc, eq, gte, inArray, ne } from 'drizzle-orm';
import { z } from 'zod';
import EmptyState from '../../../components/admin/EmptyState.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Alert from '../../../components/Alert.astro';
import Button from '../../../components/Button.astro';
import ShareImage from '../../../components/admin/ShareImage.astro';
import SocialPostsTable from '../../../components/admin/SocialPostsTable.astro';
import { getDb } from '../../../db';
import { events, posts, socialPosts } from '../../../db/schema';
import { formatDate } from '../../../lib/format';
import { getSettings } from '../../../lib/settings';
import {
  connectedNetworks,
  eventShareItem,
  networkSetup,
  postShareItem,
  socialPostAction,
} from '../../../lib/social';

// Social media overview: what is scheduled, what went out, and the events and posts to share.
const db = getDb();
const actor = Astro.locals.adminEmail ?? 'admin';
const now = new Date();
let message: { tone: 'success' | 'danger'; text: string } | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = z.coerce.number().int().positive().safeParse(form.get('id'));
  if (id.success) message = await socialPostAction(String(form.get('action')), id.data, actor, now);
}

const settings = await getSettings();
const [upcomingEvents, recentPosts, planned, past] = await Promise.all([
  db
    .select()
    .from(events)
    .where(and(eq(events.status, 'published'), gte(events.startsAt, now)))
    .orderBy(asc(events.startsAt)),
  db
    .select()
    .from(posts)
    .where(eq(posts.status, 'published'))
    .orderBy(desc(posts.publishedAt))
    .limit(10),
  db
    .select()
    .from(socialPosts)
    .where(eq(socialPosts.status, 'scheduled'))
    .orderBy(asc(socialPosts.scheduledAt)),
  db
    .select()
    .from(socialPosts)
    .where(ne(socialPosts.status, 'scheduled'))
    .orderBy(desc(socialPosts.scheduledAt))
    .limit(50),
]);
const items = [
  ...(await Promise.all(upcomingEvents.map((e) => eventShareItem(e, settings.eventCovers)))),
  ...(await Promise.all(recentPosts.map(postShareItem))),
];

// Titles of what the scheduled and past posts are about.
const rows = [...planned, ...past];
const ids = (entity: 'event' | 'post') => [
  ...new Set(rows.filter((r) => r.entity === entity).map((r) => r.entityId)),
];
const [eventTitles, postTitles] = await Promise.all([
  ids('event').length
    ? db
        .select({ id: events.id, title: events.title })
        .from(events)
        .where(inArray(events.id, ids('event')))
    : [],
  ids('post').length
    ? db
        .select({ id: posts.id, title: posts.title })
        .from(posts)
        .where(inArray(posts.id, ids('post')))
    : [],
]);
const about = new Map<string, { title: string; href: string }>();
for (const e of eventTitles)
  about.set(`event:${e.id}`, { title: e.title, href: `/admin/social/event/${e.id}` });
for (const p of postTitles)
  about.set(`post:${p.id}`, { title: p.title, href: `/admin/social/post/${p.id}` });
const connected = connectedNetworks();
const setup = networkSetup();
// What still has to be added in Cloudflare for a network, in plain words.
const missingParts = (s: { id: boolean; token: boolean }, idName: string, tokenName: string) =>
  [!s.id && `the page ID (${idName})`, !s.token && `the token (${tokenName})`].filter(Boolean);
const status = {
  linkedin: missingParts(setup.linkedin, 'LINKEDIN_ORGANIZATION_ID', 'LINKEDIN_ACCESS_TOKEN'),
  facebook: missingParts(setup.facebook, 'FACEBOOK_PAGE_ID', 'FACEBOOK_PAGE_TOKEN'),
};
const workerSettings = 'Workers & Pages > ft-bkk-site > Settings > Variables and Secrets';
const missing = items.filter((i) => !i.imageUrl).length;
---

<AdminLayout
  title="Social media posts"
  intro="Share an event or a post now, or schedule its announcement and the day-before reminder."
>
  <Fragment slot="help">
    <p>
      Every event and blog post has a share image, made by itself. Open one below to share it. The
      links to our pages shown in the site footer are in{' '}
      <a href="/admin/settings?section=social-links">Settings &gt; Social links</a>.
    </p>
  </Fragment>
  {message && (
    <Alert tone={message.tone} class="mb-6">
      {message.text}
    </Alert>
  )}

  <section class="admin-panel mb-6">
    <h2 class="mb-2 text-lg">Connected pages</h2>
    <p class="mb-3 text-sm text-muted">
      Once a page is connected, scheduled posts go out on it by themselves. Until then they arrive
      by email to post by hand. Connecting is done once, in Cloudflare: open "How to connect" under
      each network.
    </p>
    <ul class="grid gap-4 text-sm">
      <li data-network="linkedin">
        <p>
          <strong>LinkedIn:</strong>{' '}
          {connected.linkedin ? (
            <span class="font-semibold text-success">connected</span>
          ) : (
            <span class="font-semibold text-warning">not connected</span>
          )}
          {connected.linkedin
            ? ', posts go out automatically.'
            : `. Still missing: ${status.linkedin.join(' and ')}.`}
        </p>
        <details class="mt-1">
          <summary class="cursor-pointer text-accent">How to connect LinkedIn</summary>
          <ol class="mt-2 grid list-decimal gap-2 pl-5">
            <li>
              Go to{' '}
              <a
                href="https://www.linkedin.com/developers/apps"
                rel="noopener"
                class="text-accent underline"
              >
                linkedin.com/developers
              </a>{' '}
              and create an app linked to the La French Tech Bangkok page. A page admin has to
              verify the link.
            </li>
            <li>
              In the app's <strong>Products</strong> tab, request the{' '}
              <strong>Community Management API</strong>. LinkedIn reviews the request; it can take a
              few days.
            </li>
            <li>
              Once granted, open <strong>Auth &gt; OAuth 2.0 tools</strong>, create a token with the{' '}
              <code>w_organization_social</code> scope while signed in as a page admin, and copy it.
            </li>
            <li>
              Find the page's number: open the page as admin, the address is{' '}
              <code>linkedin.com/company/&lt;number&gt;/admin</code>.
            </li>
            <li>
              In the Cloudflare dashboard, open <strong>{workerSettings}</strong>, click{' '}
              <strong>Add</strong>, choose type <strong>Secret</strong>, name{' '}
              <code>LINKEDIN_ACCESS_TOKEN</code>, paste the token and click <strong>Deploy</strong>.
              Secrets stay through every update of the site.
            </li>
            <li>
              The page number goes in the site's settings file, not in the dashboard (the dashboard
              value is reset by the next update): set <code>LINKEDIN_ORGANIZATION_ID</code> in{' '}
              <code>wrangler.jsonc</code> on GitHub, or ask Claude to do it. It is live after the
              next deploy.
            </li>
            <li>
              Come back here: LinkedIn shows <strong>connected</strong>. The token lasts 60 days.
              When it expires, posts arrive by email again with a note to renew it: repeat step 3
              and replace the secret's value (step 5).
            </li>
          </ol>
        </details>
      </li>
      <li data-network="facebook">
        <p>
          <strong>Facebook:</strong>{' '}
          {connected.facebook ? (
            <span class="font-semibold text-success">connected</span>
          ) : (
            <span class="font-semibold text-warning">not connected</span>
          )}
          {connected.facebook
            ? ', posts go out automatically.'
            : `. Still missing: ${status.facebook.join(' and ')}.`}
        </p>
        <details class="mt-1">
          <summary class="cursor-pointer text-accent">How to connect Facebook</summary>
          <ol class="mt-2 grid list-decimal gap-2 pl-5">
            <li>
              Go to{' '}
              <a
                href="https://developers.facebook.com/apps"
                rel="noopener"
                class="text-accent underline"
              >
                developers.facebook.com
              </a>
              , create an app of type <strong>Business</strong> and add the{' '}
              <strong>Pages API</strong>.
            </li>
            <li>
              Open the <strong>Graph API Explorer</strong>, pick the app, add the permissions{' '}
              <code>pages_manage_posts</code> and <code>pages_read_engagement</code>, then choose
              <strong> Get Page Access Token</strong> for La French Tech Bangkok's page.
            </li>
            <li>
              Make it last: in the <strong>Access Token Debugger</strong>, click{' '}
              <strong>Extend Access Token</strong>. A page token made from a long-lived token does
              not expire. Copy it.
            </li>
            <li>
              Find the page ID: on the Facebook page, <strong>About &gt; Page transparency</strong>,
              or in the Graph API Explorer next to the page name.
            </li>
            <li>
              In the Cloudflare dashboard, open <strong>{workerSettings}</strong>, click{' '}
              <strong>Add</strong>, choose type <strong>Secret</strong>, name{' '}
              <code>FACEBOOK_PAGE_TOKEN</code>, paste the token and click <strong>Deploy</strong>.
            </li>
            <li>
              The page ID goes in the site's settings file: set <code>FACEBOOK_PAGE_ID</code> in{' '}
              <code>wrangler.jsonc</code> on GitHub, or ask Claude to do it. It is live after the
              next deploy.
            </li>
            <li>
              Come back here: Facebook shows <strong>connected</strong>.
            </li>
          </ol>
        </details>
      </li>
      <li>
        <strong>WhatsApp:</strong> no automatic posting to groups exists. Due posts arrive by email
        with a button that opens WhatsApp with the text.
      </li>
    </ul>
    <p class="mt-4 text-sm text-muted">
      Link previews on LinkedIn, Facebook and WhatsApp need the public pages to open without the
      Cloudflare Access login (Access only on <code>/admin</code> and <code>/api/admin</code>, which
      is the case today). Full technical steps: <code>docs/deploy.md</code>, section 7.
    </p>
  </section>

  <section class="admin-panel mb-6">
    <h2 class="mb-4 text-lg">Scheduled</h2>
    <SocialPostsTable rows={planned} about={about} />
  </section>

  <section class="admin-panel mb-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg">Upcoming events and recent posts</h2>
      {missing > 0 && (
        <Button size="sm" variant="secondary" data-share-batch>
          Make {missing} missing share {missing === 1 ? 'image' : 'images'}
        </Button>
      )}
    </div>
    {items.length === 0 ? (
      <EmptyState
        text="No upcoming event or published post."
        hint="Events and posts show here once published, ready to share."
      />
    ) : (
      <ul class="divide-y divide-line">
        {items.map((i) => (
          <li class="flex flex-wrap items-center justify-between gap-3 py-2 text-sm">
            <span>
              <span class="text-muted">
                {i.entity === 'event' ? formatDate(i.startsAt!) : 'Blog'}
              </span>{' '}
              · {i.title}
              {!i.imageUrl && <span class="text-muted"> (no share image yet)</span>}
            </span>
            <a href={`/admin/social/${i.entity}/${i.id}`} class="font-semibold">
              Share or schedule
            </a>
            <ShareImage
              spec={i.spec}
              fingerprint={i.fingerprint}
              url={i.imageUrl}
              variant="batch"
            />
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="admin-panel">
    <h2 class="mb-4 text-lg">History</h2>
    <SocialPostsTable rows={past} about={about} />
  </section>
</AdminLayout>
