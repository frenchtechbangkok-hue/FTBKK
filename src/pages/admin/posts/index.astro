---
import { desc, eq, sql } from 'drizzle-orm';
import EmptyState from '../../../components/admin/EmptyState.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import { getDb } from '../../../db';
import { posts } from '../../../db/schema';
import Alert from '../../../components/Alert.astro';
import { formatDate } from '../../../lib/format';
import { moveByline } from '../../../lib/byline';
import { audit } from '../../../lib/orgs';

const db = getDb();
// Posts whose author is still typed at the top of the text (imported from Wix, never re-saved).
const withByline = async () =>
  (await db.select({ id: posts.id, bodyMd: posts.bodyMd, authors: posts.authors }).from(posts))
    .filter((p) => !p.authors.length)
    .flatMap((p) => {
      const moved = moveByline(p);
      return moved ? [{ id: p.id, ...moved }] : [];
    });
let movedCount: number | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'move-bylines') {
    const pending = await withByline();
    for (const { id, ...set } of pending) {
      await db.update(posts).set(set).where(eq(posts.id, id));
    }
    await audit(Astro.locals.adminEmail ?? 'admin', 'move-bylines', 'post', null, null, {
      ids: pending.map((p) => p.id),
    });
    movedCount = pending.length;
  }
}
const bylineCount = (await withByline()).length;

const q = (Astro.url.searchParams.get('q') ?? '').toLowerCase();
const rows = (
  await db
    .select({
      id: posts.id,
      slug: posts.slug,
      title: posts.title,
      status: posts.status,
      publishedAt: posts.publishedAt,
      updatedAt: posts.updatedAt,
    })
    .from(posts)
    .orderBy(sql`${posts.publishedAt} is null desc`, desc(posts.publishedAt), desc(posts.updatedAt))
).filter((p) => !q || p.title.toLowerCase().includes(q));
const now = new Date();
---

<AdminLayout title="Blog posts" intro="News, recaps and Tech Pulse editions.">
  <Fragment slot="actions">
    <Button href="/admin/posts/new" size="sm">
      New post
    </Button>
  </Fragment>
  {movedCount !== null && (
    <Alert tone="success" class="mb-4">
      {`Moved the typed author of ${movedCount} ${movedCount === 1 ? 'post' : 'posts'} into the Authors list.`}
    </Alert>
  )}
  {bylineCount > 0 && (
    <form method="post" class="admin-panel mb-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm">
        {`${bylineCount} ${bylineCount === 1 ? 'post still has its author' : 'posts still have their author'} typed at the top of the text (By … / role / La French Tech Bangkok).`}
      </p>
      <Button type="submit" name="action" value="move-bylines" size="sm" variant="secondary">
        Move them to the Authors list
      </Button>
    </form>
  )}
  <form method="get" role="search" class="mb-4 flex max-w-md gap-2">
    <label for="q" class="sr-only">
      Search posts
    </label>
    <input
      id="q"
      name="q"
      type="search"
      value={q}
      placeholder="Search titles"
      class="admin-input"
    />
  </form>
  <div class="admin-panel overflow-x-auto">
    {rows.length ? (
      <table class="admin-table" data-sortable>
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Published</th>
            <th>Last edit</th>
            <th title="Page views over the last 30 days, from Cloudflare Web Analytics">
              Views (30 days)
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td data-sort={p.title}>
                <a href={`/admin/posts/${p.id}`} class="font-semibold">
                  {p.title}
                </a>
              </td>
              <td
                data-sort={
                  p.status === 'published' && p.publishedAt && p.publishedAt > now
                    ? 'scheduled'
                    : p.status
                }
              >
                {p.status === 'published' && p.publishedAt && p.publishedAt > now ? (
                  <Badge tone="accent">scheduled</Badge>
                ) : (
                  <Badge tone={p.status === 'published' ? 'success' : 'neutral'}>{p.status}</Badge>
                )}
              </td>
              <td class="whitespace-nowrap" data-sort={p.publishedAt?.getTime() ?? 0}>
                {p.publishedAt ? formatDate(p.publishedAt) : '–'}
              </td>
              <td class="whitespace-nowrap text-muted" data-sort={p.updatedAt.getTime()}>
                {formatDate(p.updatedAt)}
              </td>
              <td data-post-views={`/blog/${p.slug}`} data-sort="0" class="text-muted">
                –
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <EmptyState
        text={q ? `No post matches “${q}”.` : 'No posts yet.'}
        action={
          q
            ? { href: '/admin/posts', label: 'Show all posts' }
            : { href: '/admin/posts/new', label: 'Write the first one' }
        }
      />
    )}
  </div>
  <script>
    // Page views per post, from Cloudflare (Reports > Website traffic needs the same token).
    const cells = document.querySelectorAll<HTMLElement>('[data-post-views]');
    if (cells.length)
      fetch('/api/admin/post-views')
        .then((r) => r.json() as Promise<{ views?: Record<string, number> }>)
        .then((d) => {
          if (!d.views) return;
          cells.forEach((c) => {
            const n = d.views![c.dataset.postViews!] ?? 0;
            c.textContent = n.toLocaleString('en-GB');
            c.dataset.sort = String(n);
            c.classList.remove('text-muted');
          });
        })
        .catch(() => {});
  </script>
</AdminLayout>
