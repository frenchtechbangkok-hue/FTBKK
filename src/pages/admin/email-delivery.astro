---
import { z } from 'zod';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Alert from '../../components/Alert.astro';
import Button from '../../components/Button.astro';
import FormField from '../../components/FormField.astro';
import {
  defaultEmailProvider,
  emailProvider,
  PROVIDER_NAMES,
  providerReady,
  sendEmail,
  type EmailProvider,
} from '../../lib/email';
import { listSuppressions, unsuppress } from '../../lib/email-suppressions';
import { audit, siteUrl } from '../../lib/orgs';
import { formatDate } from '../../lib/format';
import { saveSettings } from '../../lib/settings';
import {
  cleanSetupValue,
  emailEnv,
  emailSetupStatus,
  newEventsKey,
  saveEmailSetup,
  SETUP_FIELDS,
  type EmailEnv,
  type SetupGroup,
} from '../../lib/email-setup';

// Settings > Email delivery: the setup of Resend and Amazon SES (keys, secrets, webhook
// addresses, typed here and kept in email_setup, else the Worker's values: src/lib/email-setup.ts),
// which service sends the site's emails (chosen here, stored in the
// settings table; EMAIL_PROVIDER in wrangler.jsonc until then), a test send
// through either one (to try Amazon SES before switching), and the addresses no longer emailed
// because they bounced or marked an email as spam.
const actor = Astro.locals.adminEmail ?? 'admin';
const PROVIDERS = Object.keys(PROVIDER_NAMES) as EmailProvider[];
const PROVIDER_NOTES: Record<EmailProvider, string> = {
  resend: 'Free plan: 100 emails a day, 3,000 a month. A community email stops at the daily cap.',
  ses: 'Pay as you go: about US$0.10 per 1,000 emails, billed each month by AWS.',
};

const GROUP_NAMES: Record<SetupGroup, string> = {
  general: 'Sender',
  resend: 'Resend',
  ses: 'Amazon SES',
};
const SOURCE: Record<string, string> = {
  admin: 'saved here',
  worker: 'from Cloudflare (Worker variable or secret)',
  none: 'not set',
};

const Action = z.discriminatedUnion('intent', [
  z.object({
    intent: z.literal('test'),
    to: z.email('Enter a valid email.'),
    provider: z.enum(['resend', 'ses']),
  }),
  z.object({ intent: z.literal('unsuppress'), email: z.email() }),
  z.object({ intent: z.literal('provider'), provider: z.enum(['resend', 'ses']) }),
  z.object({ intent: z.literal('setup'), group: z.enum(['general', 'resend', 'ses']) }),
  z.object({ intent: z.literal('events-key') }),
]);

let notice = '';
let error = '';
let testTo = actor.includes('@') ? actor : '';
let current = await emailProvider();
let testProvider: EmailProvider = current;
// The Setup fold just saved (kept open), and values that could not be saved, shown back.
let setupGroup: SetupGroup | null = null;
const typed: Partial<EmailEnv> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = Action.safeParse(Object.fromEntries(form));
  if (!parsed.success) error = parsed.error.issues[0]?.message ?? 'Invalid request.';
  else if (parsed.data.intent === 'test') {
    const { to, provider } = parsed.data;
    testTo = to;
    testProvider = provider;
    const res = await sendEmail(
      {
        to,
        subject: `[Test] Sent through ${PROVIDER_NAMES[provider]}`,
        paragraphs: [
          `This is a test from Admin > Email delivery, sent through ${PROVIDER_NAMES[provider]} from ${(await emailEnv()).EMAIL_FROM}.`,
          `If it landed in spam, the sending domain's DNS records (SPF, DKIM, DMARC) need a look. Sent by ${actor}.`,
        ],
        action: { label: 'Open the admin', url: siteUrl('/admin/email-delivery') },
      },
      { provider },
    ).catch((e: unknown) => ({ ok: false, error: String(e), suppressed: [] as string[] }));
    await audit(actor, 'test-email', 'settings', null, null, { to, provider, ok: res.ok });
    if (res.suppressed?.length) {
      error = `${to} is on the list below (it bounced or marked an email as spam), so nothing was sent. Remove it first to test with it.`;
    } else if (res.ok) {
      notice = `${PROVIDER_NAMES[provider]} accepted the test for ${to}. It should arrive within a minute; if not, look in spam.`;
    } else error = `${PROVIDER_NAMES[provider]} refused the test: ${res.error ?? 'unknown error'}`;
  } else if (parsed.data.intent === 'provider') {
    const { provider } = parsed.data;
    if (!(await providerReady(provider))) {
      error = `${PROVIDER_NAMES[provider]} has no key yet, so it can't send. Add it in Setup below first.`;
    } else if (provider !== current) {
      await saveSettings({ emailProvider: provider });
      await audit(actor, 'email-provider', 'settings', null, { provider: current }, { provider });
      notice = `Every email now goes through ${PROVIDER_NAMES[provider]}. Send a test below to check.`;
      current = provider;
      testProvider = provider;
    }
  } else if (parsed.data.intent === 'setup') {
    const group = parsed.data.group;
    const patch: Partial<EmailEnv> = {};
    const problems: string[] = [];
    for (const f of SETUP_FIELDS.filter((x) => x.group === group)) {
      const raw = String(form.get(f.key) ?? '');
      if (form.get(`${f.key}__remove`) === 'on') {
        patch[f.key] = '';
        continue;
      }
      // An empty secret box keeps the saved secret; an empty plain box removes the admin value.
      if (f.secret && !raw.trim()) continue;
      const clean = cleanSetupValue(f, raw);
      if ('error' in clean) {
        problems.push(clean.error);
        if (!f.secret) typed[f.key] = raw;
      } else patch[f.key] = clean.value;
    }
    if (problems.length) {
      error = `Nothing saved. ${problems.join(' ')}`;
      setupGroup = group;
    } else {
      const changed = await saveEmailSetup(patch, actor);
      setupGroup = group;
      // Only the names of what changed go in the log, never a value.
      if (changed.length)
        await audit(actor, 'email-setup', 'settings', null, null, { keys: changed });
      notice = changed.length
        ? `Saved. ${GROUP_NAMES[group]} uses the new values from now on.`
        : 'Nothing changed.';
      current = await emailProvider();
      testProvider = current;
    }
  } else if (parsed.data.intent === 'events-key') {
    await saveEmailSetup({ SES_EVENTS_KEY: newEventsKey() }, actor);
    setupGroup = 'ses';
    await audit(actor, 'email-setup', 'settings', null, null, { keys: ['SES_EVENTS_KEY'] });
    notice =
      'New notifications key saved. The SNS subscription address below changed: in AWS SNS, add a subscription with the new address (HTTPS) and delete the old one.';
  } else {
    await unsuppress(parsed.data.email);
    await audit(actor, 'unsuppress', 'email', null, { email: parsed.data.email }, null);
    notice = `${parsed.data.email} gets emails again.`;
  }
}

const blocked = await listSuppressions();
const setup = await emailEnv();
const fields = await emailSetupStatus();
const ready = Object.fromEntries(
  await Promise.all(PROVIDERS.map(async (p) => [p, await providerReady(p, setup)] as const)),
) as Record<EmailProvider, boolean>;
// Only a service with its key can be chosen; the one in use always shows.
const choosable = PROVIDERS.filter((p) => ready[p] || p === current);
const eventsUrl = setup.SES_EVENTS_KEY
  ? siteUrl(`/api/ses-events?key=${encodeURIComponent(setup.SES_EVENTS_KEY)}`)
  : '';
const resendWebhookUrl = siteUrl('/api/resend-events');
const REASONS = { bounce: 'Bounced', complaint: 'Marked as spam' } as const;
---

<AdminLayout
  title="Email delivery"
  intro="Which service sends the site's emails, a test through either one, the Resend and Amazon SES setup, and the addresses the site no longer emails."
>
  {notice && (
    <Alert tone="success" class="mb-6">
      {notice}
    </Alert>
  )}
  {error && (
    <Alert tone="danger" class="mb-6">
      {error}
    </Alert>
  )}

  <div class="grid max-w-3xl gap-6">
    <section class="admin-panel grid gap-3">
      <h2 class="text-lg">Sending service</h2>
      <p>
        Emails go through <strong>{PROVIDER_NAMES[current]}</strong>, from {setup.EMAIL_FROM}.
      </p>
      <ul class="grid gap-1 text-sm">
        {PROVIDERS.map((p) => (
          <li>
            {PROVIDER_NAMES[p]}:{' '}
            {ready[p] ? (
              <span class="text-success">key set</span>
            ) : (
              <span class="text-muted">no key</span>
            )}
            {p === current && ' (in use)'}
          </li>
        ))}
      </ul>
      <form method="post" class="grid gap-3">
        <input type="hidden" name="intent" value="provider" />
        <fieldset class="grid gap-2">
          <legend class="mb-1 text-sm font-semibold">Send every email through</legend>
          {choosable.map((p) => (
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-line p-3 has-checked:border-accent has-checked:bg-accent/5">
              <input
                type="radio"
                name="provider"
                value={p}
                checked={p === current}
                class="mt-1 size-4 accent-brand"
              />
              <span class="grid gap-0.5">
                <span class="font-semibold">
                  {PROVIDER_NAMES[p]}
                  {p === current && <span class="font-normal text-muted"> (in use)</span>}
                </span>
                <span class="text-sm text-muted">{PROVIDER_NOTES[p]}</span>
              </span>
            </label>
          ))}
        </fieldset>
        <div>
          <Button
            type="submit"
            variant="secondary"
            size="sm"
            data-confirm="Send every email of the site (registrations, reminders, community emails) through this service?"
          >
            Use this service
          </Button>
        </div>
      </form>
      <p class="text-sm text-muted">
        Switching takes effect at once and can be undone here at any time. A service shows only once
        its key is set in Setup below. Until a choice is saved, the site uses{' '}
        {PROVIDER_NAMES[defaultEmailProvider()]} (EMAIL_PROVIDER in wrangler.jsonc).
      </p>
    </section>

    <section class="admin-panel">
      <h2 class="mb-3 text-lg">Send a test</h2>
      <form method="post" class="grid gap-4">
        <input type="hidden" name="intent" value="test" />
        <FormField name="to" label="Send to" type="email" required value={testTo} />
        <FormField
          name="provider"
          label="Through"
          value={testProvider}
          options={PROVIDERS.map((p) => ({
            value: p,
            label: `${PROVIDER_NAMES[p]}${p === current ? ' (in use)' : ''}`,
          }))}
          hint="Either service can be tried, even the one not in use."
        />
        <div>
          <Button type="submit" variant="secondary" size="sm">
            Send the test
          </Button>
        </div>
      </form>
    </section>

    <section class="admin-panel grid gap-4" id="setup" aria-labelledby="setup-title">
      <div>
        <h2 id="setup-title" class="text-lg">
          Setup
        </h2>
        <p class="mt-1 text-sm text-muted">
          Everything Resend and Amazon SES need, set here. A value saved here wins over the one in
          Cloudflare (Worker variables and secrets); clear it to go back to Cloudflare's. Secrets
          are never shown again once saved: type a new one to replace it.
        </p>
      </div>
      {(['general', 'resend', 'ses'] as const).map((group) => (
        <details class="rounded-lg border border-line p-4" open={setupGroup === group || undefined}>
          <summary class="cursor-pointer font-semibold text-navy">
            {GROUP_NAMES[group]}
            <span class="ml-2 text-sm font-normal text-muted">
              {group === 'general'
                ? setup.EMAIL_FROM || 'not set'
                : ready[group]
                  ? `ready${group === current ? ', sends now' : ''}`
                  : 'no key yet'}
            </span>
          </summary>
          {group === 'resend' && (
            <div class="mt-3 grid gap-2 text-sm">
              <p>
                <strong>Webhook address</strong> (Resend &gt; Webhooks &gt; Add webhook, events: all
                the email.* ones), for Reports &gt; Emails:
              </p>
              <p class="flex flex-wrap items-center gap-2">
                <code class="break-all">{resendWebhookUrl}</code>
                <Button type="button" variant="secondary" size="sm" data-copy={resendWebhookUrl}>
                  Copy
                </Button>
              </p>
              <p class="text-muted">
                Then copy the webhook's signing secret into the box below. For opens and clicks:
                Resend &gt; Domains &gt; the sending domain &gt; Open and Click tracking on.
              </p>
            </div>
          )}
          {group === 'ses' && (
            <div class="mt-3 grid gap-2 text-sm">
              <p>
                <strong>SNS subscription address</strong> (AWS &gt; SNS &gt; the topic &gt; Create
                subscription, protocol HTTPS), for bounces, spam complaints and Reports &gt; Emails:
              </p>
              {eventsUrl ? (
                <p class="flex flex-wrap items-center gap-2">
                  <code class="break-all">{eventsUrl}</code>
                  <Button type="button" variant="secondary" size="sm" data-copy={eventsUrl}>
                    Copy
                  </Button>
                </p>
              ) : (
                <p class="text-muted">Generate a notifications key first (below).</p>
              )}
              <form method="post">
                <input type="hidden" name="intent" value="events-key" />
                <Button
                  type="submit"
                  variant="secondary"
                  size="sm"
                  data-confirm={
                    eventsUrl
                      ? 'Make a new key? The address above stops working: SNS must get the new one.'
                      : undefined
                  }
                >
                  {eventsUrl ? 'Generate a new notifications key' : 'Generate a notifications key'}
                </Button>
              </form>
              <p class="text-muted">
                For the full report (sends, deliveries, opens, clicks): SES &gt; Configuration sets
                &gt; Create set, add an event destination to the same SNS topic with all event
                types, and type the set's name below.
              </p>
            </div>
          )}
          <form method="post" class="mt-4 grid gap-4" autocomplete="off">
            <input type="hidden" name="intent" value="setup" />
            <input type="hidden" name="group" value={group} />
            {fields
              .filter((f) => f.group === group)
              .map((f) => (
                <div class="grid gap-1">
                  <FormField
                    name={f.key}
                    label={f.label}
                    type={f.secret ? 'password' : f.number ? 'number' : 'text'}
                    autocomplete={f.secret ? 'new-password' : 'off'}
                    value={
                      f.secret
                        ? ''
                        : setupGroup === group && typed[f.key] !== undefined
                          ? typed[f.key]
                          : f.source === 'admin'
                            ? f.shown
                            : ''
                    }
                    placeholder={
                      f.secret
                        ? f.source === 'none'
                          ? f.placeholder
                          : `Set (${f.shown}). Type a new one to replace it.`
                        : f.source === 'worker'
                          ? f.shown
                          : f.placeholder && `For example ${f.placeholder}`
                    }
                    hint={`${f.hint} Now: ${SOURCE[f.source]}${!f.secret && f.source === 'worker' ? ` (${f.shown})` : ''}.`}
                  />
                  {f.source === 'admin' && (
                    <label class="flex items-center gap-2 text-xs text-muted">
                      <input
                        type="checkbox"
                        name={`${f.key}__remove`}
                        class="size-4 accent-brand"
                      />
                      Remove the value saved here
                      {f.secret ? ' (Cloudflare’s applies again, if any)' : ''}
                    </label>
                  )}
                </div>
              ))}
            <div>
              <Button type="submit" size="sm">
                Save {GROUP_NAMES[group]}
              </Button>
            </div>
          </form>
        </details>
      ))}
    </section>

    <section class="admin-panel grid gap-3">
      <h2 class="text-lg">Addresses no longer emailed ({blocked.length})</h2>
      <p class="text-sm text-muted">
        Amazon SES reports addresses that don't exist (bounced) and people who marked an email as
        spam. Every email skips them, so a dead address doesn't hurt the sender's reputation again.
        Remove one only when you know the address works again.
      </p>
      {blocked.length > 0 && (
        <div class="overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Email</th>
                <th>Why</th>
                <th>Since</th>
                <th>
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {blocked.map((b) => (
                <tr>
                  <td class="break-all">{b.email}</td>
                  <td>
                    {REASONS[b.reason]}
                    {b.detail && <span class="block text-xs text-muted">{b.detail}</span>}
                  </td>
                  <td class="whitespace-nowrap">{formatDate(b.createdAt)}</td>
                  <td>
                    <form method="post">
                      <input type="hidden" name="intent" value="unsuppress" />
                      <input type="hidden" name="email" value={b.email} />
                      <Button
                        type="submit"
                        variant="danger"
                        size="sm"
                        data-confirm={`Email ${b.email} again?`}
                      >
                        Remove
                      </Button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</AdminLayout>
