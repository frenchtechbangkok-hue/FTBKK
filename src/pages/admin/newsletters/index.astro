---
import { desc } from 'drizzle-orm';
import { z } from 'zod';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Alert from '../../../components/Alert.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import { getDb } from '../../../db';
import { newsletters } from '../../../db/schema';
import { formatDate, formatTime } from '../../../lib/format';
import { parseBlocks } from '../../../lib/newsletter-blocks';
import { STARTERS, type Starter } from '../../../lib/newsletter-block-defs';
import { NEWSLETTER_AUDIENCES, STATUS_LABELS, listKpis } from '../../../lib/newsletters';
import { audit } from '../../../lib/orgs';

// Emails and social media > Newsletters: the list (drafts, scheduled, sent with their figures)
// and "New newsletter", which opens the builder (./[id].astro).
const db = getDb();
const actor = Astro.locals.adminEmail ?? 'admin';
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const starter = z
    .enum(Object.keys(STARTERS) as [Starter, ...Starter[]])
    .catch('news')
    .parse(form.get('starter'));
  if (form.get('action') === 'create') {
    const [row] = await db
      .insert(newsletters)
      .values({
        subject: 'New newsletter',
        blocks: parseBlocks(STARTERS[starter].blocks()),
        createdBy: actor,
        updatedBy: actor,
      })
      .returning({ id: newsletters.id });
    await audit(actor, 'create', 'newsletter', row!.id, null, { subject: 'New newsletter' });
    return Astro.redirect(`/admin/newsletters/${row!.id}`, 303);
  }
  error = 'Unknown action.';
}

const rows = await db
  .select({
    id: newsletters.id,
    subject: newsletters.subject,
    status: newsletters.status,
    audience: newsletters.audience,
    scheduledAt: newsletters.scheduledAt,
    sentAt: newsletters.sentAt,
    startedAt: newsletters.startedAt,
    recipients: newsletters.recipients,
    sentCount: newsletters.sentCount,
    suppressed: newsletters.suppressed,
    updatedAt: newsletters.updatedAt,
    error: newsletters.error,
  })
  .from(newsletters)
  .orderBy(desc(newsletters.updatedAt), desc(newsletters.id))
  .limit(200);
const kpis = await listKpis(rows.filter((r) => r.status !== 'draft').map((r) => r.id));
const rate = (n: number, of: number) => (of ? `${Math.round((n / of) * 100)}%` : '–');
const tone = {
  draft: 'neutral',
  scheduled: 'accent',
  sending: 'warning',
  sent: 'success',
  failed: 'danger',
} as const;
const when = (d: Date | null) => (d ? `${formatDate(d)} ${formatTime(d)}` : '');
---

<AdminLayout
  title="Newsletters"
  intro="Build a newsletter from blocks, send yourself a test, then send it now or at a set time. Each one gets its own figures."
>
  <Fragment slot="help">
    <p>
      A newsletter is made of blocks you add, move and remove: header, text, pictures, photo grid,
      key figures, percentage bars, people, event and blog cards, a whole event recap (figures,
      photos, speakers, slides, video, partners), video, button and logos. For a quick message,
      <a href="/admin/community-email">Email the community</a> is simpler.
    </p>
  </Fragment>
  {error && (
    <Alert tone="danger" class="mb-6">
      {error}
    </Alert>
  )}
  <form method="post" class="admin-panel mb-6 flex flex-wrap items-end gap-4">
    <input type="hidden" name="action" value="create" />
    <label class="grid gap-1 text-sm">
      <span class="font-semibold text-ink">Start from</span>
      <select name="starter" class="rounded-lg border border-line px-3 py-2 focus:border-accent">
        {Object.entries(STARTERS).map(([k, s]) => (
          <option value={k}>{s.label}</option>
        ))}
      </select>
    </label>
    <Button type="submit">New newsletter</Button>
  </form>

  <section class="admin-panel" aria-labelledby="all-title">
    <h2 id="all-title" class="text-lg">
      All newsletters
    </h2>
    {rows.length ? (
      <div class="mt-3 overflow-x-auto">
        <table class="w-full min-w-[44rem] text-sm">
          <thead>
            <tr class="border-b border-line text-left text-muted">
              <th class="py-2 pr-3 font-semibold">Subject</th>
              <th class="py-2 pr-3 font-semibold">Status</th>
              <th class="py-2 pr-3 font-semibold">To</th>
              <th class="py-2 pr-3 text-right font-semibold">Sent</th>
              <th class="py-2 pr-3 text-right font-semibold">Opened</th>
              <th class="py-2 pr-3 text-right font-semibold">Clicked</th>
              <th class="py-2 pr-3 text-right font-semibold">Visits</th>
              <th class="py-2 text-right font-semibold">Unsubscribed</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => {
              const k = kpis.get(r.id);
              const e = k?.email;
              return (
                <tr class="border-b border-line align-top">
                  <td class="py-2 pr-3">
                    <a href={`/admin/newsletters/${r.id}`} class="font-semibold">
                      {r.subject}
                    </a>
                    <span class="block text-xs text-muted">
                      {r.status === 'sent'
                        ? `Sent ${when(r.sentAt)}`
                        : r.status === 'scheduled'
                          ? `Goes out ${when(r.scheduledAt)}`
                          : r.status === 'sending'
                            ? `${r.sentCount} of ${r.recipients} so far`
                            : `Edited ${when(r.updatedAt)}`}
                    </span>
                  </td>
                  <td class="py-2 pr-3">
                    <Badge tone={tone[r.status]}>{STATUS_LABELS[r.status]}</Badge>
                  </td>
                  <td class="py-2 pr-3">{NEWSLETTER_AUDIENCES[r.audience].label}</td>
                  <td class="py-2 pr-3 text-right">
                    {r.status === 'draft' ? '–' : r.sentCount - r.suppressed}
                  </td>
                  <td class="py-2 pr-3 text-right">{e ? rate(e.opened, e.delivered) : '–'}</td>
                  <td class="py-2 pr-3 text-right">{e ? rate(e.clicked, e.delivered) : '–'}</td>
                  <td class="py-2 pr-3 text-right">{k ? k.visits : '–'}</td>
                  <td class="py-2 text-right">{k ? k.unsubscribed : '–'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="mt-3">
        <EmptyState text="No newsletter yet. Choose how to start, then click New newsletter." />
      </div>
    )}
  </section>
</AdminLayout>
