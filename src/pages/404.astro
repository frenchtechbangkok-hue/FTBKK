---
import { privatePage } from '../lib/edge-cache';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
Astro.response.status = 404;
// Personal or one-off page: never kept by browsers or Cloudflare's edge (lib/edge-cache.ts).
privatePage(Astro);
---

<BaseLayout title="Page not found" noindex>
  <section class="container-page py-24 text-center">
    <p class="font-display text-6xl font-extrabold text-brand">404</p>
    <h1 class="mt-4 text-3xl">This page doesn't exist</h1>
    <p class="mt-3 text-muted">It may have moved when we rebuilt the site.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/">Home</Button>
      <Button href="/events" variant="secondary">
        Events
      </Button>
      <Button href="/ecosystem" variant="secondary">
        Ecosystem
      </Button>
    </div>
  </section>
</BaseLayout>
