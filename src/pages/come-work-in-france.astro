---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guideMode, linkOnline } from '../lib/guides';
import { getSettings } from '../lib/settings';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Checklist from '../components/guide/Checklist.astro';
import Faq from '../components/guide/Faq.astro';
import GuideHero from '../components/guide/GuideHero.astro';
import SectionHead from '../components/guide/SectionHead.astro';
import SourceLinks from '../components/guide/SourceLinks.astro';
import {
  ALL_SOURCES,
  BENEFITS,
  CHECKLIST,
  CRITERIA,
  FAQ,
  KEY_FACTS,
  OFFICIAL_SITES,
  RESOURCES,
  STEPS,
  TRACKS,
  VISA_CHECKED_LABEL,
  VISA_SOURCES,
  WHY_FRANCE,
  WHY_POINTS,
  type VisaSourceKey,
} from '../lib/work-in-france';

// Come work in France: an English adaptation of La French Tech's "Come work in France" and French
// Tech Visa pages, for talent, founders and investors in Thailand who want to move to France. Same
// design as the two Thailand guides; content in lib/work-in-france.ts. /french-tech-visa redirects
// to the visa section. Listed in the Resources menu, the footer and the
// sitemap once it is online (Admin > Settings > Guide pages).
const toc = [
  { href: '#why', label: 'Why France' },
  { href: '#visa', label: 'The French Tech Visa' },
  { href: '#tracks', label: 'Employees, founders, investors' },
  { href: '#company', label: 'Is the company innovative?' },
  { href: '#apply', label: 'Applying from Thailand' },
  { href: '#official', label: 'Official websites and support' },
  { href: '#help', label: 'Find a job, get help' },
  { href: '#checklist', label: 'Your checklist' },
  { href: '#faq', label: 'Questions' },
];
const sourceLinks = (keys: readonly VisaSourceKey[]) => keys.map((k) => VISA_SOURCES[k]);
// Offline guides answer 404 to the public; admins see a preview.
const settings = await getSettings();
const mode = await guideMode(Astro, settings, '/come-work-in-france');
if (mode === 'hidden') return Astro.rewrite('/404');
const preview = mode === 'preview';
const showFounders = linkOnline(settings, '/founders-guide');
---

<BaseLayout
  title="Come work in France: jobs, startups and the French Tech Visa"
  noindex={preview}
  cache={!preview}
  description="Working, founding a startup or investing in France: why France, the French Tech Visa (a 4-year renewable Talent residence permit), how to apply from Thailand and where to find a job."
>
  <GuideHero
    eyebrow="Come work in France"
    title="Work, found or invest in French tech"
    intro="France wants international tech talent, and makes it easier with the French Tech Visa: a renewable residence permit of up to 4 years for employees of innovative startups, founders and investors, with their families. Why France, how the visa works, how to apply from Thailand and where to find your job."
    checked={VISA_CHECKED_LABEL}
    notice="Figures and conditions come from the official French pages linked on this page. They change: confirm on those pages, or with the French Embassy's visa services, before you apply."
    toc={toc}
    preview={preview}
    other={
      showFounders
        ? {
            href: '/founders-guide',
            question: 'Building your startup in Thailand instead?',
            label: "Read the Founder's Guide",
          }
        : null
    }
  />

  <!-- 01 Why France -->
  <section id="why" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="01 · Why France"
        title="A country that wants tech talent"
        intro="Startups, investment and quality of life, in the figures La French Tech puts forward."
      />
      <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {WHY_FRANCE.map((f) => (
          <div class="flex flex-col rounded-card border border-line bg-paper p-6 shadow-card">
            <dt class="order-2 mt-2 text-ink">{f.label}</dt>
            <dd class="order-1 font-display text-4xl font-bold text-brand">{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {WHY_POINTS.map((p) => (
          <article class="rounded-card bg-surface p-6">
            <h3 class="text-xl">{p.title}</h3>
            <p class="mt-2">{p.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-xs text-muted">
        Source:{' '}
        <a href={VISA_SOURCES.comeWork.url} class="underline" rel="noopener" target="_blank">
          {VISA_SOURCES.comeWork.label}
        </a>
        , citing the EY attractiveness barometer, the ESNA report and the Shanghai Ranking.
      </p>
    </div>
  </section>

  <!-- 02 The French Tech Visa -->
  <section id="visa" class="scroll-mt-20 bg-navy py-14 text-paper md:py-20">
    <div class="container-page">
      <div class="mb-10 grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
        <div>
          <p class="eyebrow eyebrow-light">02 · A visa made for tech talent</p>
          <h2 class="text-4xl leading-tight text-paper md:text-5xl">The French Tech Visa</h2>
          <p class="mt-4 text-xl text-paper md:text-2xl">
            France's dedicated fast track to relocate tech employees, founders and investors, with
            their families.
          </p>
          <p class="mt-4 text-lg text-accent-soft">
            One simplified procedure gets you a multi-year "Talent" residence permit, which is also
            your work permit. Business France runs it with the Mission French Tech, through the{' '}
            <a
              href={VISA_SOURCES.frenchTech.url}
              class="text-paper underline"
              rel="noopener"
              target="_blank"
            >
              Welcome to La French Tech desk
            </a>
            .
          </p>
        </div>
        <div class="rounded-card bg-paper p-6 text-ink">
          <p class="font-display text-lg font-bold text-navy">Who it is for</p>
          <ul class="mt-3 grid gap-2">
            {TRACKS.map((t) => (
              <li>
                <a
                  href="#tracks"
                  data-track-link={t.id}
                  class="flex items-center justify-between gap-3 rounded-xl bg-surface px-4 py-3 font-semibold text-navy no-underline hover:bg-line"
                >
                  {t.label}
                  <Icon name="arrow" class="size-4 shrink-0 text-brand" />
                </a>
              </li>
            ))}
          </ul>
          <a
            href={VISA_SOURCES.frenchTech.url}
            rel="noopener"
            target="_blank"
            class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent"
          >
            Official French Tech Visa page <Icon name="external" class="size-4" />
          </a>
        </div>
      </div>
      <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {KEY_FACTS.map((f) => (
          <div class="flex flex-col rounded-card bg-paper/5 p-6">
            <dt class="order-2 mt-2 text-paper/85">{f.label}</dt>
            <dd class="order-1 font-display text-4xl font-bold text-accent-soft">{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {BENEFITS.map((b) => (
          <article class="rounded-card bg-paper p-6 text-ink">
            <Icon name="check" class="size-6 text-success" />
            <h3 class="mt-3 text-xl">{b.title}</h3>
            <p class="mt-2">{b.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-xs text-paper/70">
        Sources:{' '}
        {[VISA_SOURCES.frenchTech, VISA_SOURCES.family].map((src, i) => (
          <>
            {i > 0 && ' · '}
            <a href={src.url} class="underline" rel="noopener" target="_blank">
              {src.label}
            </a>
          </>
        ))}
      </p>
    </div>
  </section>

  <!-- 03 Tracks: each button shows its panel; without JavaScript every panel is visible. -->
  <section id="tracks" class="scroll-mt-20 bg-surface py-14 md:py-20" data-tracks>
    <div class="container-page">
      <SectionHead
        eyebrow="03 · Three tracks"
        title="Employees, founders, investors"
        intro="Open to nationals of every country outside the EU, the EEA and Switzerland, Algeria excepted (a Franco-Algerian agreement applies). Pick yours to see the conditions."
      />
      <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Your track">
        {TRACKS.map((t, i) => (
          <button
            type="button"
            class="chip cursor-pointer aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-paper"
            data-track={t.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {t.label}
          </button>
        ))}
      </div>
      {TRACKS.map((t) => (
        <article
          class="mb-6 grid gap-6 rounded-card border border-line bg-paper p-6 shadow-card md:p-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
          data-track-panel={t.id}
          aria-live="polite"
        >
          <div class="flex flex-col">
            <h3 class="text-2xl">French Tech Visa for {t.label}</h3>
            <p class="mt-2 text-muted">{t.who}</p>
            <dl class="mt-6">
              <dt class="text-xs font-semibold tracking-[0.15em] text-brand-dark uppercase">
                Residence status
              </dt>
              <dd class="mt-1" lang="fr">
                {t.status}
              </dd>
            </dl>
            {t.note && (
              <p class="mt-6 flex gap-3 rounded-xl bg-surface p-3 text-sm">
                <Icon name="bulb" class="mt-0.5 size-5 shrink-0 text-brand" />
                <span>{t.note}</span>
              </p>
            )}
            <p class="mt-6">
              <Button
                href={VISA_SOURCES[t.sources[0]].url}
                variant="secondary"
                size="sm"
                target="_blank"
                rel="noopener"
              >
                Full details on Business France <Icon name="external" class="size-4" />
              </Button>
            </p>
            <SourceLinks sources={sourceLinks(t.sources)} />
          </div>
          <div>
            <p class="text-xs font-semibold tracking-[0.15em] text-brand-dark uppercase">
              Conditions
            </p>
            <ul class="mt-3 grid gap-3">
              {t.conditions.map((c) => (
                <li class="flex gap-3 rounded-xl bg-surface p-4">
                  <Icon name="check" class="mt-0.5 size-5 shrink-0 text-success" />
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 04 Innovative company -->
  <section id="company" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="04 · The employer"
        title="Is the company innovative?"
        intro="For the employee track, the hiring company must be registered in France, with a 14-digit SIRET number, and meet at least one of these three criteria."
      />
      <ol class="grid gap-5 md:grid-cols-3">
        {CRITERIA.map((c, i) => (
          <li class="flex flex-col rounded-card border border-line bg-paper p-6">
            <span class="font-display text-sm font-bold text-brand tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-xl">{c.title}</h3>
            <p class="mt-2">{c.text}</p>
            {c.source && <SourceLinks sources={[VISA_SOURCES[c.source]]} label="See:" />}
          </li>
        ))}
      </ol>
      <div class="mt-8 flex flex-col gap-4 rounded-card bg-navy p-6 text-paper md:flex-row md:items-center md:justify-between md:p-8">
        <p class="max-w-2xl">
          <strong class="text-paper">The attestation.</strong> The company proves it with an online
          attestation of its innovative character, valid for 3 years and renewable. Every employee's
          visa or permit file needs it.
        </p>
        <Button href={VISA_SOURCES.attestation.url} variant="light" target="_blank" rel="noopener">
          Request the attestation <Icon name="external" class="size-4" />
        </Button>
      </div>
    </div>
  </section>

  <!-- 05 Applying from Thailand -->
  <section id="apply" class="scroll-mt-20 bg-surface py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="05 · Applying from Thailand"
        title="From Bangkok to France in five steps"
        intro="The order of the procedure when you apply from Thailand."
      />
      <ol class="grid gap-4 lg:grid-cols-5">
        {STEPS.map((s, i) => (
          <li class="flex flex-col rounded-card border border-line bg-paper p-6">
            <span
              aria-hidden="true"
              class="flex size-10 items-center justify-center rounded-full bg-navy font-display font-bold text-paper"
            >
              {i + 1}
            </span>
            <h3 class="mt-4 text-xl">{s.title}</h3>
            <p class="mt-2">{s.text}</p>
            <SourceLinks sources={sourceLinks(s.sources)} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 06 Official websites and support: the procedures happen there, this page sums them up. -->
  <section id="official" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="06 · Official websites and support"
        title="Where the procedures happen"
        intro="This page sums up the rules in English. Your visa application, your residence permit and the latest official information are on these French government websites, and Business France answers questions from companies and talent coming to France. Check them before you apply."
      />
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {OFFICIAL_SITES.map((o) => (
          <li>
            <a
              href={VISA_SOURCES[o.source].url}
              rel="noopener"
              target="_blank"
              class="group flex h-full flex-col rounded-card border border-line bg-paper p-6 text-ink no-underline shadow-card transition-colors hover:border-navy"
            >
              <span class="text-xs font-semibold tracking-[0.15em] text-brand-dark uppercase">
                {o.by}
              </span>
              <span class="mt-2 font-display text-xl font-bold text-navy">{o.name}</span>
              <span class="mt-2 flex-1">{o.text}</span>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold break-all text-accent">
                {o.domain}
                <Icon name="external" class="size-4 shrink-0" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 07 Jobs and help -->
  <section id="help" class="scroll-mt-20 bg-surface py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="07 · Find a job, get help"
        title="Where to start"
        intro="Official places to find a startup job and answers on setting up, tax, social security and visas."
      />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {RESOURCES.map((r) => (
          <a
            href={VISA_SOURCES[r.source].url}
            rel="noopener"
            target="_blank"
            class="group flex flex-col rounded-card border border-line bg-paper p-6 text-ink no-underline shadow-card transition-colors hover:border-navy"
          >
            <h3 class="flex items-center justify-between gap-3 text-xl">
              {r.title}
              <Icon name="external" class="size-4 shrink-0 text-accent" />
            </h3>
            <p class="mt-2">{r.text}</p>
          </a>
        ))}
        <a
          href="/events"
          class="group flex flex-col rounded-card bg-brand p-6 text-paper no-underline shadow-card"
        >
          <h3 class="flex items-center justify-between gap-3 text-xl text-paper">
            Meet us in Bangkok
            <Icon name="arrow" class="size-4 shrink-0" />
          </h3>
          <p class="mt-2 text-paper/90">
            Our events bring together French startups and people who already made the move.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- 08 Checklist -->
  <section id="checklist" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page">
      <Checklist
        eyebrow="08 · Checklist"
        title="Before you apply"
        phases={CHECKLIST}
        storageKey="ftbkk-french-tech-visa-checklist"
      />
    </div>
  </section>

  <!-- 09 FAQ and sources -->
  <section id="faq" class="scroll-mt-20 bg-surface py-14 md:py-20">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">09 · Questions</p>
      <h2 class="text-3xl leading-tight md:text-4xl">Questions we hear</h2>
      <Faq items={FAQ} sources={ALL_SOURCES} checked={VISA_CHECKED_LABEL} />
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-brand py-16 text-paper md:py-20">
    <div class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="max-w-2xl">
        <h2 class="text-3xl leading-snug text-paper md:text-4xl">Heading to French tech?</h2>
        <p class="mt-3 text-lg text-paper/90">
          Meet people who made the move, and French startups hiring, at La French Tech Bangkok.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <Button href="/join" variant="light">
          Join the community
        </Button>
        <Button href={VISA_SOURCES.comeWork.url} variant="light" target="_blank" rel="noopener">
          La French Tech <Icon name="external" class="size-4" />
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Track picker: show only the chosen track once JavaScript runs.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tracks]')) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-track]');
    const panels = root.querySelectorAll<HTMLElement>('[data-track-panel]');
    const show = (id: string) => {
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.track === id));
      for (const p of panels) p.hidden = p.dataset.trackPanel !== id;
    };
    for (const b of buttons) b.addEventListener('click', () => show(b.dataset.track ?? ''));
    if (buttons[0]) show(buttons[0].dataset.track ?? '');
  }
  // "Who it is for" links in the visa section open the matching track.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-track-link]')) {
    link.addEventListener('click', () => {
      document
        .querySelector<HTMLButtonElement>(`[data-track="${link.dataset.trackLink}"]`)
        ?.click();
    });
  }
</script>
